# Copy to .env. Never commit .env. No real secrets belong in this file.

# development | staging | production
APP_ENV=development
APP_NAME=crypto-signals-with-grok-bot
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

# Shared secret for protected /api/v1 routes (header: X-API-Key).
# Empty is allowed only when APP_ENV=development. Set a long random value
# in staging and production.
API_KEY=

# The planning skeleton boots without Mongo. Phase 1 connects on startup.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=crypto_signals

# Planned worker interval, in seconds. The skeleton worker does not scan.
SCAN_INTERVAL_SECONDS=900

# Public signup stays closed until the legal gate in docs/saas.md.
PUBLIC_SIGNUP=false

# Required once login exists. Empty in this planning skeleton.
JWT_SECRET=

# Required only when user exchange keys are encrypted. Unused now.
SECRETS_KEY=
